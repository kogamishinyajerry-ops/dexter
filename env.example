# LLM API Keys
LLM_API_OPENAI_KEY=your-openai-api-key
LLM_API_OPENAI_MODEL=gpt-4o
LLM_API_OPENAI_STRONG_MODEL=gpt-4o

LLM_API_ANTHROPIC_KEY=your-anthropic-api-key
LLM_API_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_API_ANTHROPIC_STRONG_MODEL=claude-3-5-sonnet-20241022

# 可选：DeepSeek API (国内可用)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# A股数据源
TUSHARE_TOKEN=your-tushare-token

# Web Search API (可选)
TAVILY_API_KEY=your-tavily-api-key

# LangSmith
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=astock-advisor
LANGSMITH_TRACING=true

# Context Management
AUTO_CLEAN_CONTEXT_ON_STARTUP=true
